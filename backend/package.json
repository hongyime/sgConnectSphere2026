{
  "name": "@connectsphere/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:reset": "tsx src/database/cli.ts reset",
    "db:seed:test": "tsx src/database/cli.ts seed",
    "db:validate": "tsx src/database/cli.ts validate",
    "notifications:inspect-legacy": "tsx src/database/inspectLegacyNotifications.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/dev.ts",
    "test": "tsx --test tests/registration.test.ts tests/eventVisibility.test.ts tests/venueCatalogue.test.ts tests/verificationTokens.test.ts tests/eventLifecycle.test.ts",
    "test:db": "tsx --test tests/registration.db.test.ts tests/eventVisibility.integration.test.ts tests/attendeeVisibility.integration.test.ts tests/venueCatalogue.integration.test.ts",
    "test:profile": "tsx --test tests/profile.test.ts",
    "test:profile:db": "tsx --test tests/profile.integration.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@upstash/redis": "latest",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.21.0",
    "typescript": "latest"
  }
}
