{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker4s/master/stryker4js-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress", "json"],
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run test --workspace backend"
  },
  "mutate": [
    "backend/src/modules/**/service.ts",
    "backend/src/modules/**/repository.ts",
    "backend/src/modules/**/status.ts",
    "!backend/src/modules/**/types.ts",
    "!backend/src/modules/**/index.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  },
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 2,
  "disableTypeChecks": "backend/src/**/*.ts"
}
