{
  "buildCommand": "npm run build --workspace frontend",
  "installCommand": "npm install",
  "ignoreCommand": "git rev-parse HEAD^ >/dev/null 2>&1 && git diff --quiet HEAD^ HEAD -- api backend frontend package.json package-lock.json vercel.json",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/outbox-relay",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/hold-expiry",
      "schedule": "50 23 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/equipment", "destination": "/api/venues?task=equipment" },
    {
      "source": "/api/notifications",
      "destination": "/api/notifications/send?task=inbox"
    },
    {
      "source": "/api/cron/notification-worker",
      "destination": "/api/cron/outbox-relay?task=worker"
    },
    {
      "source": "/api/cron/hold-expiry",
      "destination": "/api/cron/outbox-relay?task=holds"
    },
    {
      "source": "/api/auth/verify",
      "destination": "/api/auth/session?task=verify"
    },
    {
      "source": "/api/auth/request-reset",
      "destination": "/api/auth/session?task=request-reset"
    },
    {
      "source": "/api/auth/reset-password",
      "destination": "/api/auth/session?task=reset-password"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
