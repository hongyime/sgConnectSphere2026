{
  "buildCommand": "npm run build --workspace frontend",
  "installCommand": "npm install",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/outbox-relay",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron/notification-worker",
      "destination": "/api/cron/outbox-relay?task=worker"
    },
    {
      "source": "/api/auth/verify",
      "destination": "/api/auth/session?task=verify"
    },
    {
      "source": "/api/auth/request-reset",
      "destination": "/api/auth/session?task=request-reset"
    },
    {
      "source": "/api/auth/reset-password",
      "destination": "/api/auth/session?task=reset-password"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
