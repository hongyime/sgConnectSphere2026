# SG ConnectSphere environment template.
# Copy this file to .env for local app runtime, or copy the relevant values into
# Vercel/Supabase/Jira provider dashboards.
# Do not commit real URLs, tokens, passwords, cloud IDs, account IDs, or secrets.

# -----------------------------------------------------------------------------
# App runtime
# -----------------------------------------------------------------------------

APP_ENV=development
APP_NAME=SG ConnectSphere

# Public browser URL for the deployed frontend, for example:
# https://sgconnectsphere.hong-yi.me or https://sgconnectsphere.vercel.app
APP_URL=https://sgconnectsphere.hong-yi.me
PUBLIC_SITE_URL=https://sgconnectsphere.hong-yi.me

# Public API base URL if frontend and backend deploy separately.
API_BASE_URL=
PUBLIC_API_BASE_URL=

# Comma-separated origins allowed to call the backend.
CORS_ALLOWED_ORIGINS=

# Generate strong random values before running real auth/session code.
SESSION_SECRET=
JWT_SECRET=

# -----------------------------------------------------------------------------
# Supabase / PostgreSQL
# -----------------------------------------------------------------------------

# Recommended free-tier provider for PostgreSQL, auth, and file storage.
DATA_PROVIDER=supabase

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=

# Server-side only. Never expose this in frontend bundles.
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL connection string for migrations/server code.
DATABASE_URL=

# Optional separate pooled/direct URLs if the chosen backend needs both.
DATABASE_POOLER_URL=
DATABASE_DIRECT_URL=

# Integration test database. Must point to loopback (127.0.0.1 or localhost).
# DB name must match connectsphere_notification_test*. See docs/contributing/seed-data-convention.md.
TEST_DATABASE_URL=

# Optional Supabase Auth settings.
SUPABASE_AUTH_SITE_URL=
SUPABASE_AUTH_REDIRECT_URL=

# Optional Supabase Storage buckets for generated assets or uploaded evidence.
SUPABASE_STORAGE_BUCKET=
SUPABASE_PUBLIC_ASSETS_BUCKET=

# -----------------------------------------------------------------------------
# Vercel deployment, functions, and cron
# -----------------------------------------------------------------------------

# Recommended free-tier deployment provider for frontend, API, and scheduled jobs.
HOSTING_PROVIDER=vercel

VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=sgconnectsphere
VERCEL_TOKEN=
VERCEL_REGION=sin1

# Shared secret for protecting cron endpoints called by Vercel Cron Jobs.
CRON_SECRET=
# Documentation only: vercel.json owns the actual once-daily relay schedule.
OUTBOX_RELAY_CRON_SCHEDULE=0 0 * * *
EVENT_COMPLETION_CRON_SCHEDULE=0 * * * *

# -----------------------------------------------------------------------------
# Queue / async jobs
# -----------------------------------------------------------------------------

# Team choice: PostgreSQL remains the durable outbox source of truth; Upstash
# Redis is the async queue transport for notification jobs.
QUEUE_PROVIDER=upstash-redis
REDIS_PROVIDER=upstash

REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_DATABASE_NAME=sgconnectsphere
UPSTASH_REDIS_QUEUE_NOTIFICATIONS=sgconnectsphere:notifications

# Keep both false until the private database, retained legacy queue, provider
# settings, quota headroom and separately agreed worker cadence are verified.
NOTIFICATION_RELAY_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false

# -----------------------------------------------------------------------------
# Email provider
# -----------------------------------------------------------------------------

# Recommended free-tier provider is Brevo because the previous sgStyleSnap2025
# deployment used Brevo successfully. Resend remains an alternative.
EMAIL_PROVIDER=brevo
EMAIL_FROM=noreply-sgconnectsphere@hong-yi.me
EMAIL_FROM_NAME=SG ConnectSphere
EMAIL_REPLY_TO=

BREVO_API_KEY=
BREVO_MCP_API_KEY=
RESEND_API_KEY=

# Optional SMTP fallback if the team chooses a provider with SMTP credentials.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# -----------------------------------------------------------------------------
# Jira local agent/API connection
# -----------------------------------------------------------------------------

# Example: https://example.atlassian.net
JIRA_SITE_URL=

# Example: CS
JIRA_PROJECT_KEY=

# Your own Jira login email, if your connector/API method needs it.
JIRA_EMAIL=

# Your own Jira API token or connector secret. Never share this with teammates.
JIRA_API_TOKEN=

# Optional values for tools that use Atlassian Cloud IDs or explicit account IDs.
JIRA_CLOUD_ID=
JIRA_ACCOUNT_ID=

# Optional defaults for import/sync scripts.
JIRA_DEFAULT_ISSUE_TYPE=Story
JIRA_FUTURE_BACKLOG_LABEL=future-backlog
JIRA_GITHUB_REPOSITORY=hongyime/sgConnectSphere2026

