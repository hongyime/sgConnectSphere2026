{
  "name": "sgconnectsphere2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:reset": "npm run db:reset --workspace backend",
    "db:seed:test": "npm run db:seed:test --workspace backend",
    "db:validate": "npm run db:validate --workspace backend",
    "typecheck": "npm run typecheck --workspace frontend && npm run typecheck --workspace backend",
    "preview": "npm run preview --workspace frontend",
    "test:e2e": "playwright test",
    "test:runtime": "node --test \"tests/runtime/*.test.mjs\"",
    "test:notifications": "node --import tsx --test \"tests/notifications/*.test.ts\"",
    "test:redis": "node --import tsx --test \"tests/redis/*.test.ts\"",
    "test:e2e:scaffold": "playwright test --reporter=list",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "test:coverage:backend": "npm run test --workspace backend",
    "test:coverage:frontend": "npm run test:coverage --workspace frontend",
    "test:coverage:tooling": ".venv-tools/bin/python -m coverage run -m pytest tooling/tests/ && .venv-tools/bin/python -m coverage report",
    "test:coverage": "npm run test:coverage:backend && npm run test:coverage:frontend && npm run test:coverage:tooling",
    "test:mutation": "npx stryker run"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/tap-runner": "^10.0.0",
    "@types/node": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.14.47": true
  }
}
